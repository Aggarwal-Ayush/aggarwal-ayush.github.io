keyword = {2.1 Biological and endogenous factors},
keyword = {Generic health relevance},
keyword = {Animals},
keyword = {Melanocytes},
keyword = {Pigmentation},
keyword = {Pigmentation Disorders},
keyword = {Reverse Genetics},
keyword = {Zebrafish},
